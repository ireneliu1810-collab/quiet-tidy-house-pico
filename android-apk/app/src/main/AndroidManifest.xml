<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/quiet_house_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/quiet_house_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuietTidyHouse"
        tools:targetApi="31">

        <meta-data
            android:name="com.pico.spatial.SPATIAL_APP"
            android:value="true" />

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.QuietTidyHouse">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Progressive full-space Stage keeps the rain garden outside the application panel. -->
            <meta-data
                android:name="pico.spatial.stage.id"
                android:value="QuietRainGardenStage" />
            <meta-data
                android:name="pico.spatial.stage.style"
                android:value="2" />
            <meta-data
                android:name="pico.spatial.stage.immersion"
                android:value="90" />
            <meta-data
                android:name="pico.spatial.stage.immersion_min"
                android:value="60" />
            <meta-data
                android:name="pico.spatial.stage.immersion_max"
                android:value="100" />
        </activity>
    </application>

</manifest>
